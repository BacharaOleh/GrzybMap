#!/bin/sh
# $1 -- Remote name
# $2 -- Remote URL
REQUIRED_EMAIL="83633550+BacharaOleh@users.noreply.github.com"
z40=0000000000000000000000000000000000000000

while read local_ref local_sha remote_ref remote_sha
do
    if [ "$local_sha" = "$z40" ]; then
        continue
    fi

    if [ "$remote_sha" = "$z40" ]; then
        range="$local_sha"
    else
        range="$remote_sha..$local_sha"
    fi

    INVALID_COMMITS=""
    for c in $(git rev-list "$range"); do
        author_email=$(git log -1 --format="%ae" "$c")
        if [ "$author_email" != "$REQUIRED_EMAIL" ]; then
            INVALID_COMMITS="$INVALID_COMMITS $c"
        fi
    done

    if [ -n "$INVALID_COMMITS" ]; then
        echo "==========================================================" >&2
        echo "ERROR: Git push rejected!" >&2
        echo "Found commits not authored by $REQUIRED_EMAIL:" >&2
        for c in $INVALID_COMMITS; do
            git log -1 --format="  %h %an <%ae> - %s" "$c" >&2
        done
        echo "All commits in this repository must be authored by BacharaOleh." >&2
        echo "==========================================================" >&2
        exit 1
    fi
done

exit 0
